# 构建产物
build/
dist/
*.crx
*.zip
*.pem
/.workbuddy/memory
# 2026-11-13：会话私有目录整体忽略。原来只写了 memory/，
# 导致 audit-work/ 一直以未跟踪状态挂在 git status 里，容易被误提交。
/.workbuddy/
# 一次性探针脚本（probe-*.py 之类），属过程产物，见 ARTIFACT-MANAGEMENT.md §3.4
/work-tmp/
# 根目录的过程截图（1.5MB，未被任何文档引用），按 §4.2 不入库
/preview.png

# 敏感文件（含 GitHub token 等凭据，严禁提交）
.env
*.local

# 临时诊断截图（tools/overlay-*.py 跑出来的）
.tmp/

# Python 缓存（tools/ 下的 CDP 测试脚本会生成）
__pycache__/
*.pyc

# 本机临时工作区（浏览器 profile / 测试媒体 / 一次性草稿，可整体删除）
# 正式位置在仓库外：..\work\（规范见 docs/ARTIFACT-MANAGEMENT.md §3）
/.work/
/work/

# 资源库根目录：下载内容不进 git
/download/

# 测试站视频夹具（从 .work/media 复制，可随时重建）
/test-site/media/

# 公开前治理（2026-11-09）：未引用的截图留证在本地，不进 git
# 规范见 docs/ARTIFACT-MANAGEMENT.md §4.2（只有被文档引用的截图才可进 git）
/archive/deliverables-unreferenced/

# 套件级诊断日志（e2e-all 每次覆盖写，过程产物不入库）
/deliverables/test-runs/parts/
