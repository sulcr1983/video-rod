{
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_icon": "img/icon.png",
    "default_title": "__MSG_catCatch__"
  },
  "side_panel": {
    "default_path": "image.html"
  },
  "description": "__MSG_description__",
  "icons": {
    "64": "/img/icon.png",
    "128": "/img/icon128.png"
  },
  "manifest_version": 3,
  "minimum_chrome_version": "93",
  "name": "__MSG_catCatch__",
  "homepage_url": "https://github.com/xifangczy/cat-catch",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "webRequest",
    "downloads",
    "storage",
    "webNavigation",
    "alarms",
    "declarativeNetRequest",
    "scripting",
    "sidePanel",
    "contextMenus",
    "offscreen",
    "unlimitedStorage",
    "bookmarks"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "打开苏哥的钓鱼竿面板"
    },
    "enable": {
      "description": "__MSG_pause__ / __MSG_enable__"
    },
    "auto_down": {
      "description": "__MSG_autoDownload__"
    },
    "catch": {
      "description": "__MSG_cacheCapture__"
    },
    "m3u8": {
      "description": "__MSG_m3u8Parser__"
    },
    "clear": {
      "description": "__MSG_clear__"
    },
    "reboot": {
      "description": "__MSG_restartExtension__"
    },
    "deepSearch": {
      "description": "__MSG_deepSearch__"
    },
    "preview": {
      "description": "__MSG_preview__"
    },
    "imgDownload": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "下载鼠标悬停的图片"
    },
    "imgPanelOpen": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "打开本页图片清单"
    }
  },
  "host_permissions": [
    "*://*/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "js/net-sniff.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "js/content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "js/naming.js",
        "js/site-name.js",
        "js/library/path.js",
        "js/x-button.js",
        "js/bulk-profile.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "js/naming.js",
        "js/video-quality.js",
        "js/video-overlay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://weibo.com/*",
        "*://*.weibo.com/*",
        "*://m.weibo.cn/*"
      ],
      "js": [
        "js/weibo-album-core.js",
        "js/bulk-profile.js",
        "js/weibo-backup.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.xiaohongshu.com/*"
      ],
      "js": [
        "js/bulk-profile.js",
        "js/xhs-batch.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.instagram.com/*"
      ],
      "js": [
        "js/instagram.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "js/yt/yt-options.js",
        "js/yt/yt-page.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "js/vr-msg.js",
        "js/lib-image-util.js",
        "js/lib-download-scan.js",
        "js/site-name.js",
        "js/image-batch.js",
        "js/lib/floating-ui.core.umd.min.js",
        "js/lib/floating-ui.dom.umd.min.js",
        "js/image-hover.js",
        "js/image-panel.js",
        "js/image-album.js",
        "js/image-drag.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "default_locale": "en",
  "version": "2.7.2.1",
  "incognito": "split",
  "sandbox": {
    "pages": [
      "js/yt/nsig-sandbox.html"
    ]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-inline' 'unsafe-eval'; object-src 'self'"
  }
}
